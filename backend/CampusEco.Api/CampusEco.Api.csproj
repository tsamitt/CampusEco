<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CampusEco.Api</RootNamespace>
  </PropertyGroup>

  <!-- IMPORTANT: Pomelo (the MySQL provider) has no EF Core 10 build yet, so every EF Core
       package is pinned to 9.0.21. Do not "upgrade" these to 10.x or the app will crash at runtime. -->
  <ItemGroup>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.21" />
  </ItemGroup>

</Project>
